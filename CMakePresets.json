{
  "version": 3,
  "configurePresets": [
    {
      "name": "windows-x64",
      "displayName": "Windows x64 (Release)",
      "generator": "Ninja",
      "architecture": { "value": "x64", "strategy": "external" },
      "binaryDir": "${sourceDir}/out/build/${presetName}",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
    }
  ],
  "buildPresets": [{ "name": "windows-x64", "configurePreset": "windows-x64" }],
  "testPresets": [{ "name": "windows-x64", "configurePreset": "windows-x64", "output": { "outputOnFailure": true } }]
}
